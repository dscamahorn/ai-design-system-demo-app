{
  // VS Code Dev Container for ai-design-system-demo-app.
  // Open the Command Palette and choose "Dev Containers: Reopen in Container".
  // Everything runs in here: editing, terminal, git, builds, the dev server,
  // and Claude Code. Nothing needs to be installed on the Mac beyond Colima
  // and VS Code.
  "name": "ai-design-system-demo-app",

  // Microsoft's Dev Container image for JavaScript/TypeScript work. It ships
  // Node 22, git, zsh, and a working global npm for the "node" user.
  // The image is described in Dockerfile next to this file.
  "build": { "dockerfile": "Dockerfile" },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Who git says made each commit. The email is GitHub's private no-reply
  // address, so no real address lands in the repo's history.
  "containerEnv": {
    "GIT_AUTHOR_NAME": "Doug Scamahorn",
    "GIT_AUTHOR_EMAIL": "6138631+dscamahorn@users.noreply.github.com",
    "GIT_COMMITTER_NAME": "Doug Scamahorn",
    "GIT_COMMITTER_EMAIL": "6138631+dscamahorn@users.noreply.github.com"
  },

  // Runs on the Mac just before the container is created, so the login file
  // exists before it is mounted ("{}" means not logged in).
  "initializeCommand": "mkdir -p ~/.claude/shared ~/.claude/skills ~/.claude/web-baseline ~/.claude/memory && ([ -f ~/.claude/.credentials.json ] || echo '{}' > ~/.claude/.credentials.json)",

  // Claude Code reads the global rules from ~/.claude. Only the pieces the
  // container needs are shared in, each as its own mount; transcripts and
  // caches stay on the Mac. The Node image's user is "node".
  "mounts": [
    "source=${localEnv:HOME}/.claude/shared,target=/home/node/.claude/shared,type=bind",
    "source=${localEnv:HOME}/.claude/.credentials.json,target=/home/node/.claude/.credentials.json,type=bind",
    "source=${localEnv:HOME}/.claude/skills,target=/home/node/.claude/skills,type=bind",
    "source=${localEnv:HOME}/.claude/web-baseline,target=/home/node/.claude/web-baseline,type=bind,readonly",
    "source=${localEnv:HOME}/.claude/memory,target=/home/node/.claude/memory,type=bind"
  ],

  // The chown first: Docker creates the mount folders as root, and Claude
  // Code must be able to write its session files in ~/.claude. Then the
  // script installs npm dependencies and the Claude Code CLI and wires up
  // .env loading for the shell.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // 8000 is the Vite dev server, 6006 is Storybook, and 9223-9232 is the
  // port range the Figma Desktop Bridge plugin uses to reach the local
  // figma-console MCP server running in this container.
  "forwardPorts": [
    8000, 6006, 9223, 9224, 9225, 9226, 9227, 9228, 9229, 9230, 9231, 9232
  ],
  "portsAttributes": {
    "8000": { "label": "Vite dev server" },
    "6006": { "label": "Storybook" }
  },

  "customizations": {
    "vscode": {
      // Extensions installed on the Mac do not carry into the container;
      // only the ones listed here get installed inside it.
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "GitHub.vscode-pull-request-github"
      ],
      // Format every file with Prettier when it is saved.
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },

  // Run as the non-root "node" user that the image ships with.
  "remoteUser": "node"
}
